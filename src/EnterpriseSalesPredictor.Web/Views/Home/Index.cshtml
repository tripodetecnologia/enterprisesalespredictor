@model EnterpriseSalesPredictor.Web.ViewModels.Dashboard.DashboardPageViewModel

@{
    ViewData["Title"] = "Panel";
}

<section class="hero">
    <h1>Panel ejecutivo</h1>
    <p>Visualiza KPIs, alertas comerciales y entidades con mejor desempeño en la operación de ventas.</p>
</section>

<section class="dashboard-kpi-grid">
    <article class="hero dashboard-kpi-card">
        <span class="dashboard-kpi-label">Ventas totales</span>
        <strong class="dashboard-kpi-value">@Model.Kpis.TotalSalesAmount.ToString("N0")</strong>
    </article>
    <article class="hero dashboard-kpi-card">
        <span class="dashboard-kpi-label">Unidades vendidas</span>
        <strong class="dashboard-kpi-value">@Model.Kpis.TotalQuantity.ToString("N0")</strong>
    </article>
    <article class="hero dashboard-kpi-card">
        <span class="dashboard-kpi-label">Transacciones</span>
        <strong class="dashboard-kpi-value">@Model.Kpis.TotalTransactions</strong>
    </article>
    <article class="hero dashboard-kpi-card">
        <span class="dashboard-kpi-label">Ticket promedio</span>
        <strong class="dashboard-kpi-value">@Model.Kpis.AverageTicket.ToString("N0")</strong>
    </article>
</section>

<section class="dashboard-grid">
    <article class="hero">
        <h2>Mejores clientes</h2>
        <partial name="_DashboardBreakdown" model="Model.TopCustomers" />
    </article>

    <article class="hero">
        <h2>Mejores productos</h2>
        <partial name="_DashboardBreakdown" model="Model.TopProducts" />
    </article>

    <article class="hero">
        <h2>Ventas por línea de producto</h2>
        <partial name="_DashboardBreakdown" model="Model.SalesByLine" />
    </article>

    <article class="hero">
        <h2>Ventas por proveedor</h2>
        <partial name="_DashboardBreakdown" model="Model.SalesBySupplier" />
    </article>
</section>

<section class="dashboard-grid">
    <article class="hero">
        <h2>Accesos rápidos</h2>
        <div class="dashboard-quick-links">
            <a asp-controller="Uploads" asp-action="Index">Revisar cargas</a>
            <a asp-controller="Sales" asp-action="Index">Consultar ventas</a>
            <a asp-controller="Audit" asp-action="Index">Inspeccionar auditoría</a>
        </div>
    </article>

    <article class="hero">
        <h2>Alertas comerciales</h2>
        @if (Model.Alerts.Count == 0)
        {
            <p>No se detectaron alertas para el conjunto actual de datos.</p>
        }
        else
        {
            <div class="dashboard-alerts">
                @foreach (var alert in Model.Alerts)
                {
                    <div class="dashboard-alert dashboard-alert-@alert.Severity.ToLowerInvariant()">
                        <strong>@alert.Title</strong>
                        <p>@alert.Message</p>
                    </div>
                }
            </div>
        }
    </article>
</section>
