@model EnterpriseSalesPredictor.Web.ViewModels.Reports.ReportsPageViewModel

@{
    ViewData["Title"] = "Reportes";
}

<section class="hero">
    <h1>Reportes empresariales</h1>
    <p>Consulta reportes gerenciales, comerciales, operativos, de abastecimiento y predictivos desde una sola pantalla.</p>
    <br />
    <div class="filter-panel">
        <partial name="_ReportFilters" model="Model.Filters" />
    </div>

    <div class="page-actions">
        <button type="button" id="reports-export-button" class="button">Exportar libro de reportes</button>
        <button type="button" id="base-data-export-button" class="button button-secondary">Exportar datos base</button>
    </div>
</section>

<section id="reports-export-status" hidden></section>

<section class="dashboard-grid reports-grid">
    <partial name="_ReportCard" model="Model.ManagementReport" />
    <partial name="_ReportCard" model="Model.CommercialReport" />
    <partial name="_ReportCard" model="Model.OperationalReport" />
    <partial name="_ReportCard" model="Model.ReplenishmentReport" />
    <partial name="_ReportCard" model="Model.PredictiveReport" />
</section>

<partial name="_Modal" model='new ModalViewModel { Id = "reports-export-modal", Title = "Exportar reportes", Message = "¿Deseas descargar el libro de reportes actual?", ConfirmLabel = "Exportar", CancelLabel = "Cancelar" }' />
<partial name="_Modal" model='new ModalViewModel { Id = "base-data-export-modal", Title = "Exportar datos base", Message = "¿Deseas descargar el libro completo de datos base?", ConfirmLabel = "Descargar", CancelLabel = "Cancelar" }' />

@section Scripts {
    <script src="~/js/pages/reports-index.js" asp-append-version="true"></script>
}
