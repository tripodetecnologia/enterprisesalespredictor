@model IReadOnlyCollection<EnterpriseSalesPredictor.Web.ViewModels.Audit.AuditLogItemViewModel>

@if (Model.Count == 0)
{
    <p>No se encontraron registros de auditoría para esta sección.</p>
}
else
{
    <table class="data-table">
        <thead>
            <tr>
                    <th>Fecha (UTC)</th>
                    <th>Usuario</th>
                    <th>Acción</th>
                    <th>Módulo</th>
                    <th>Detalle</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var entry in Model)
        {
            <tr>
                <td>@entry.OccurredAtUtc.ToString("u")</td>
                <td>@entry.Actor</td>
                <td>@entry.Action</td>
                <td>@entry.Module</td>
                <td>@entry.Details</td>
            </tr>
        }
        </tbody>
    </table>
}
