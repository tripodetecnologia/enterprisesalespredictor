@model EnterpriseSalesPredictor.Web.ViewModels.Audit.PagedAuditSectionViewModel

@if (Model.TotalCount == 0)
{
    <p>No se encontraron registros de auditoría para esta sección.</p>
}
else
{
    <p>Mostrando @(((Model.PageNumber - 1) * Model.PageSize) + 1) a @Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount) de @Model.TotalCount registros.</p>
    <table class="data-table">
        <thead>
            <tr>
                    <th>Fecha (UTC)</th>
                    <th>Usuario</th>
                    <th>Acción</th>
                    <th>Módulo</th>
                    <th>Detalle</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var entry in Model.Items)
        {
            <tr>
                <td>@entry.OccurredAtUtc.ToString("u")</td>
                <td>@entry.Actor</td>
                <td>@entry.Action</td>
                <td>@entry.Module</td>
                <td>@entry.Details</td>
            </tr>
        }
        </tbody>
    </table>
}
