@model EnterpriseSalesPredictor.Web.ViewModels.Audit.AuditPageViewModel

@{
    ViewData["Title"] = "Auditoría operativa";
}

<section class="hero">
    <h1>Auditoría operativa</h1>
    <p>Revisa eventos de carga, exportación y operación con seguridad aplicada del lado del servidor.</p>
    <br />

    <form method="get" class="audit-filters filter-panel">
        <div class="form-group">
            <label asp-for="Filters.Module">Módulo</label>
            <input asp-for="Filters.Module" />
        </div>

        <div class="form-group">
            <label asp-for="Filters.Actor">Usuario</label>
            <input asp-for="Filters.Actor" />
        </div>

        <div class="form-group">
            <label asp-for="Filters.FromUtc">Desde (UTC)</label>
            <input asp-for="Filters.FromUtc" type="datetime-local" />
        </div>

        <div class="form-group">
            <label asp-for="Filters.ToUtc">Hasta (UTC)</label>
            <input asp-for="Filters.ToUtc" type="datetime-local" />
        </div>

        <button type="submit" class="">Aplicar filtros</button>
    </form>
</section>
<br />
<section class="hero">
    <h2>Auditoría de cargas</h2>
    <br />
    <partial name="_AuditTable" model="Model.UploadLogs" />
    <div class="page-actions sales-pagination-bar">
        @if (Model.UploadLogs.PageNumber > 1)
        {
            <a class="button button-secondary" asp-action="Index" asp-route-Module="@Model.Filters.Module" asp-route-Actor="@Model.Filters.Actor" asp-route-FromUtc="@Model.Filters.FromUtc?.ToString("s")" asp-route-ToUtc="@Model.Filters.ToUtc?.ToString("s")" asp-route-uploadPage="@(Model.UploadLogs.PageNumber - 1)" asp-route-exportPage="@Model.ExportLogs.PageNumber">Anterior</a>
        }
        <span>Página @Model.UploadLogs.PageNumber de @Math.Max(Model.UploadLogs.TotalPages, 1)</span>
        @if (Model.UploadLogs.PageNumber < Model.UploadLogs.TotalPages)
        {
            <a class="button button-secondary" asp-action="Index" asp-route-Module="@Model.Filters.Module" asp-route-Actor="@Model.Filters.Actor" asp-route-FromUtc="@Model.Filters.FromUtc?.ToString("s")" asp-route-ToUtc="@Model.Filters.ToUtc?.ToString("s")" asp-route-uploadPage="@(Model.UploadLogs.PageNumber + 1)" asp-route-exportPage="@Model.ExportLogs.PageNumber">Siguiente</a>
        }
    </div>
</section>
<br />
<section class="hero">
    <h2>Auditoría de exportaciones</h2>
    <br />
    <partial name="_AuditTable" model="Model.ExportLogs" />
    <div class="page-actions sales-pagination-bar">
        @if (Model.ExportLogs.PageNumber > 1)
        {
            <a class="button button-secondary" asp-action="Index" asp-route-Module="@Model.Filters.Module" asp-route-Actor="@Model.Filters.Actor" asp-route-FromUtc="@Model.Filters.FromUtc?.ToString("s")" asp-route-ToUtc="@Model.Filters.ToUtc?.ToString("s")" asp-route-uploadPage="@Model.UploadLogs.PageNumber" asp-route-exportPage="@(Model.ExportLogs.PageNumber - 1)">Anterior</a>
        }
        <span>Página @Model.ExportLogs.PageNumber de @Math.Max(Model.ExportLogs.TotalPages, 1)</span>
        @if (Model.ExportLogs.PageNumber < Model.ExportLogs.TotalPages)
        {
            <a class="button button-secondary" asp-action="Index" asp-route-Module="@Model.Filters.Module" asp-route-Actor="@Model.Filters.Actor" asp-route-FromUtc="@Model.Filters.FromUtc?.ToString("s")" asp-route-ToUtc="@Model.Filters.ToUtc?.ToString("s")" asp-route-uploadPage="@Model.UploadLogs.PageNumber" asp-route-exportPage="@(Model.ExportLogs.PageNumber + 1)">Siguiente</a>
        }
    </div>
</section>
<br />
<section class="hero">
    <h2>Auditoría funcional</h2>
    <br />
    <partial name="_AuditTable" model="Model.FunctionalLogs" />

    @if (Model.FunctionalLogs.TotalCount > 0)
    {
        <div class="page-actions sales-pagination-bar">
            @if (Model.FunctionalLogs.PageNumber > 1)
            {
                <a class="button button-secondary" asp-action="Index" asp-route-Module="@Model.Filters.Module" asp-route-Actor="@Model.Filters.Actor" asp-route-FromUtc="@Model.Filters.FromUtc?.ToString("s")" asp-route-ToUtc="@Model.Filters.ToUtc?.ToString("s")" asp-route-uploadPage="@Model.UploadLogs.PageNumber" asp-route-exportPage="@Model.ExportLogs.PageNumber" asp-route-functionalPage="@(Model.FunctionalLogs.PageNumber - 1)">Anterior</a>
            }
            <span>Página @Model.FunctionalLogs.PageNumber de @Math.Max(Model.FunctionalLogs.TotalPages, 1)</span>
            @if (Model.FunctionalLogs.PageNumber < Model.FunctionalLogs.TotalPages)
            {
                <a class="button button-secondary" asp-action="Index" asp-route-Module="@Model.Filters.Module" asp-route-Actor="@Model.Filters.Actor" asp-route-FromUtc="@Model.Filters.FromUtc?.ToString("s")" asp-route-ToUtc="@Model.Filters.ToUtc?.ToString("s")" asp-route-uploadPage="@Model.UploadLogs.PageNumber" asp-route-exportPage="@Model.ExportLogs.PageNumber" asp-route-functionalPage="@(Model.FunctionalLogs.PageNumber + 1)">Siguiente</a>
            }
        </div>
    }
</section>
