@model EnterpriseSalesPredictor.Web.ViewModels.Audit.AuditPageViewModel

@{
    ViewData["Title"] = "Operational Audit";
}

<section class="hero">
    <h1>Operational Audit</h1>
    <p>Review load, export and functional events with server-side security enforcement.</p>

    <form method="get" class="audit-filters">
        <div class="form-group">
            <label asp-for="Filters.Module">Module</label>
            <input asp-for="Filters.Module" />
        </div>

        <div class="form-group">
            <label asp-for="Filters.Actor">Actor</label>
            <input asp-for="Filters.Actor" />
        </div>

        <div class="form-group">
            <label asp-for="Filters.FromUtc">From (UTC)</label>
            <input asp-for="Filters.FromUtc" type="datetime-local" />
        </div>

        <div class="form-group">
            <label asp-for="Filters.ToUtc">To (UTC)</label>
            <input asp-for="Filters.ToUtc" type="datetime-local" />
        </div>

        <button type="submit">Apply filters</button>
    </form>
</section>

<section class="hero">
    <h2>Upload Audit</h2>
    <partial name="_AuditTable" model="Model.UploadLogs" />
</section>

<section class="hero">
    <h2>Export Audit</h2>
    <partial name="_AuditTable" model="Model.ExportLogs" />
</section>

<section class="hero">
    <h2>Functional Audit</h2>
    <partial name="_AuditTable" model="Model.FunctionalLogs" />
</section>
