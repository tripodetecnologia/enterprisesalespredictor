@model EnterpriseSalesPredictor.Web.ViewModels.Uploads.UploadPageViewModel

@{
    ViewData["Title"] = "Carga de archivos";
}

<section class="hero">
    <h1>Carga de datos de ventas</h1>
    <br />
    <p>Carga archivos Excel o delimitados por punto y coma para incorporar históricos de ventas.</p>

    <ul>
        <li>Formatos permitidos: <strong>@UploadPolicy.AllowedExtensionsText</strong></li>
        <li>Tamaño máximo: <strong>@UploadPolicy.MaxFileSizeMegabytes MB</strong></li>
        <li>Delimitador para archivos planos: <strong>;</strong></li>
    </ul>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="status-ok">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="auth-error">@Model.ErrorMessage</div>
    }

    <form asp-action="Upload" method="post" enctype="multipart/form-data" class="auth-form upload-form" id="upload-form">
        @Html.AntiForgeryToken()

        <div class="upload-dropzone" id="upload-dropzone">
            <p class="upload-dropzone-title">Arrastra y suelta un archivo aquí</p>
            <p class="upload-dropzone-subtitle">o selecciona uno desde tu equipo.</p>
            <input type="file" name="file" id="upload-file-input" accept="@UploadPolicy.AcceptAttribute" />
        </div>

        <div class="upload-progress" id="upload-progress" hidden>
            <div class="upload-progress-bar" id="upload-progress-bar"></div>
        </div>

        <button type="submit" class="col-2">Procesar carga</button>
    </form>
</section>

@if (Model.LastResult is not null)
{
    <section class="hero">
        <h2>Último resumen de procesamiento</h2>
        <table class="data-table">
            <thead>
                <tr>
                    <th>ID de carga</th>
                    <th>Estado</th>
                    <th>Total</th>
                    <th>Válidos</th>
                    <th>Inválidos</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@Model.LastResult.UploadId</td>
                    <td>@Model.LastResult.Status</td>
                    <td>@Model.LastResult.TotalRecords</td>
                    <td>@Model.LastResult.ValidRecords</td>
                    <td>@Model.LastResult.InvalidRecords</td>
                </tr>
            </tbody>
        </table>
    </section>
}

<section class="hero">
    <h2>Historial de cargas</h2>

    @if (Model.Uploads.Count == 0)
    {
        <p>Todavía no hay cargas registradas.</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Fecha de carga (UTC)</th>
                    <th>Archivo</th>
                    <th>Type</th>
                    <th>Estado</th>
                    <th>Total</th>
                    <th>Válidos</th>
                    <th>Inválidos</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var upload in Model.Uploads)
            {
                <tr>
                    <td>@upload.UploadedAtUtc.ToString("u")</td>
                    <td>@upload.FileName</td>
                    <td>@upload.FileType</td>
                    <td>@upload.Status</td>
                    <td>@upload.TotalRecords</td>
                    <td>@upload.ValidRecords</td>
                    <td>@upload.InvalidRecords</td>
                    <td>
                        <a asp-action="Errors" asp-route-id="@upload.Id">Ver errores</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>

@section Scripts {
    <script src="~/js/pages/uploads-index.js" asp-append-version="true"></script>
}
