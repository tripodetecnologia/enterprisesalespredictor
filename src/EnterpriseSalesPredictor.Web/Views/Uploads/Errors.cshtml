@model IReadOnlyCollection<EnterpriseSalesPredictor.Web.ViewModels.Uploads.UploadErrorViewModel>

@{
    ViewData["Title"] = "Detalle de errores de carga";
    var uploadId = (Guid?)ViewData["UploadId"];
}

<section class="hero">
    <h1>Detalle de errores de carga</h1>
    <p>ID de carga: <strong>@uploadId</strong></p>
    <p>
        <a asp-action="Index">Volver a cargas</a>
    </p>
</section>

<section class="hero">
    @if (Model.Count == 0)
    {
        <p>No se registraron errores para esta carga.</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Fila</th>
                    <th>Field</th>
                    <th>Error</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var error in Model)
            {
                <tr>
                    <td>@error.RowNumber</td>
                    <td>@error.FieldName</td>
                    <td>@error.ErrorMessage</td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>
