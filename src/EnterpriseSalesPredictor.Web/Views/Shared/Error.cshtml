@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">Se produjo un error al procesar tu solicitud.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>ID de solicitud:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Modo desarrollo</h3>
<p>
    Cambiar al entorno <strong>Development</strong> mostrará información más detallada sobre el error ocurrido.
</p>
<p>
    <strong>El entorno Development no debería estar habilitado en aplicaciones desplegadas.</strong>
    Puede exponer información sensible de excepciones a usuarios finales.
    Para depuración local, habilitá el entorno <strong>Development</strong> configurando la variable <strong>ASPNETCORE_ENVIRONMENT</strong> con el valor <strong>Development</strong>
    y reiniciando la aplicación.
</p>
