<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Predictor Empresarial de Ventas</title>
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EnterpriseSalesPredictor.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
        var title = ViewData["Title"]?.ToString() ?? currentController;

        string NavClass(string controller)
        {
            return currentController.Equals(controller, StringComparison.OrdinalIgnoreCase) ? "app-nav-link app-nav-link-active" : "app-nav-link";
        }

        string NotificationClass()
        {
            return string.IsNullOrWhiteSpace(TempData["ErrorMessage"] as string) ? "app-notification app-notification-success" : "app-notification app-notification-error";
        }

        bool HasPermission(string permission)
        {
            return User.Claims.Any(claim => claim.Type == PermissionClaimTypes.Permission && (claim.Value == permission || claim.Value == PermissionValues.All));
        }

        var notificationMessage = TempData["StatusMessage"] as string ?? TempData["ErrorMessage"] as string;
    }

    <div class="app-shell">
        <aside class="app-sidebar">
            <div class="app-brand-block">
                <div class="app-brand">Predictor Empresarial de Ventas</div>
                <div class="app-brand-subtitle">Plataforma de inteligencia comercial</div>
            </div>

            <nav class="app-nav">
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <a class="@NavClass("Home")" asp-area="" asp-controller="Home" asp-action="Index">Tablero de control</a>
                    @if (HasPermission(Permissions.UploadsRead))
                    {
                        <a class="@NavClass("Uploads")" asp-area="" asp-controller="Uploads" asp-action="Index">Cargas</a>
                    }

                    @if (HasPermission(Permissions.SalesRead))
                    {
                        <a class="@NavClass("Sales")" asp-area="" asp-controller="Sales" asp-action="Index">Consulta de ventas</a>
                    }       

                    @if (HasPermission(Permissions.ReportsRead))
                    {
                        <a class="@NavClass("Reports")" asp-area="" asp-controller="Reports" asp-action="Index">Reportes</a>
                    }

                    @if (HasPermission(Permissions.ForecastsWrite))
                    {
                        <a class="@NavClass("Forecasts")" asp-area="" asp-controller="Forecasts" asp-action="Index">Proyecciones de ventas</a>
                    }

                    @if (HasPermission(Permissions.ReplenishmentRead))
                    {
                        <a class="@NavClass("Replenishment")" asp-area="" asp-controller="Replenishment" asp-action="Index">Abastecimiento</a>
                        <a class="@NavClass("ReplenishmentApprovals")" asp-area="" asp-controller="ReplenishmentApprovals" asp-action="Index">Aprobación Abastecimiento</a>
                    }
                    
                    @if (HasPermission(Permissions.UsersRead))
                    {
                        <a class="@NavClass("AccessManagement")" asp-area="" asp-controller="AccessManagement" asp-action="Index">Gestión de accesos</a>
                    }

                    @if (HasPermission(Permissions.AuditRead))
                    {
                        <a class="@NavClass("Audit")" asp-area="" asp-controller="Audit" asp-action="Index">Auditoría</a>
                    }
                }
            </nav>

            <footer class="app-sidebar-footer">
                <small>Arquitectura limpia | Razor + API</small>
            </footer>
        </aside>

        <div class="app-content">
            <header class="app-header">
                <div>
                    <div class="app-header-kicker">Espacio empresarial</div>
                    <div class="app-header-title">@title</div>
                </div>

                <div class="app-header-actions">
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <div class="app-user-chip">@User.Identity?.Name</div>
                        <form asp-controller="Auth" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="link-button">Cerrar sesión</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Login">Iniciar sesión</a>
                    }
                </div>
            </header>

            <div class="app-subheader">
                <nav class="app-breadcrumbs" aria-label="Breadcrumb">
                    <a asp-controller="Home" asp-action="Index">Inicio</a>
                    <span>/</span>
                    <span>@currentController</span>
                    @if (!currentAction.Equals("Index", StringComparison.OrdinalIgnoreCase))
                    {
                        <span>/</span>
                        <span>@currentAction</span>
                    }
                </nav>

                @if (!string.IsNullOrWhiteSpace(notificationMessage))
                {
                    <div class="@NotificationClass()">@notificationMessage</div>
                }
            </div>

            <main role="main" class="page-content">
                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>Predictor Empresarial de Ventas</span>
                <span>Analítica operativa, proyecciones y abastecimiento</span>
            </footer>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/utils/dom.js" asp-append-version="true"></script>
    <script src="~/js/utils/http.js" asp-append-version="true"></script>
    <script src="~/js/utils/number.js" asp-append-version="true"></script>
    <script src="~/js/modules/state-panels.js" asp-append-version="true"></script>
    <script src="~/js/modules/downloads.js" asp-append-version="true"></script>
    <script src="~/js/modules/chart-bars.js" asp-append-version="true"></script>
    <script src="~/js/modules/table-renderer.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
