@model EnterpriseSalesPredictor.Web.ViewModels.Access.AccessManagementPageViewModel

@{
    ViewData["Title"] = "Gestión de accesos";
}

<section class="hero">
    <h1>Gestión de accesos</h1>
    <p>Administrá usuarios, roles y permisos de la plataforma.</p>    
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="status-ok">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="auth-error">@Model.ErrorMessage</div>
    }
</section>
<br />
<section class="hero access-grid">
    <div>
        <h2>Usuarios</h2>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Rol</th>
                    <th>Permisos</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td>@user.Username</td>
                    <td>@user.Role</td>
                    <td>@string.Join(", ", user.Permissions)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div>
        <h2>Crear usuario</h2>
        <form asp-action="CreateUser" method="post" class="auth-form">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Usuario</label>
                <input asp-for="CreateUserForm.Username" name="Username" />
                <span asp-validation-for="CreateUserForm.Username" class="field-error"></span>
            </div>

            <div class="form-group">
                <label>Clave</label>
                <input asp-for="CreateUserForm.Password" name="Password" type="password" autocomplete="new-password" />
                <span asp-validation-for="CreateUserForm.Password" class="field-error"></span>
            </div>

            <div class="form-group">
                <label>Rol</label>
                <input asp-for="CreateUserForm.Role" name="Role" list="existing-roles" />
                <span asp-validation-for="CreateUserForm.Role" class="field-error"></span>
            </div>

            <datalist id="existing-roles">
                @foreach (var role in Model.Roles.Select(item => item.Role).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(item => item))
                {
                    <option value="@role"></option>
                }
            </datalist>

            <div class="form-group">
                <label>Permisos (separados por coma)</label>
                <input asp-for="CreateUserForm.PermissionsRaw" name="PermissionsRaw" />
            </div>

            <button type="submit">Crear usuario</button>
        </form>
    </div>
</section>
<br />
<section class="hero">
    <h2>Roles y permisos</h2>

    <table class="data-table">
        <thead>
            <tr>
                <th>Rol</th>
                <th>Permisos</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var role in Model.Roles)
        {
            <tr>
                <td>@role.Role</td>
                <td>@string.Join(", ", role.Permissions)</td>
            </tr>
        }
        </tbody>
    </table>

    <h3>Actualizar permisos del rol</h3>
    <form asp-action="UpdateRolePermissions" method="post" class="auth-form">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label asp-for="UpdateRoleForm.Role">Rol</label>
            <select asp-for="UpdateRoleForm.Role" name="Role">
                <option value="">Seleccione...</option>
                @foreach (var role in Model.Roles.Select(item => item.Role).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(item => item))
                {
                    if (Model.UpdateRoleForm.Role == role)
                    {
                        <option value="@role" selected>@role</option>
                    }
                    else
                    {
                        <option value="@role">@role</option>
                    }
                }
            </select>
            <span asp-validation-for="UpdateRoleForm.Role" class="field-error"></span>
        </div>

        <div class="form-group">
            <label>Permisos (separados por coma)</label>
            <input asp-for="UpdateRoleForm.PermissionsRaw" name="PermissionsRaw" />
        </div>

        <button type="submit">Actualizar rol</button>
    </form>

    <h3>Catálogo de permisos</h3>
    <p>@string.Join(", ", Model.PermissionCatalog)</p>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
