@model EnterpriseSalesPredictor.Web.ViewModels.Replenishment.ReplenishmentDetailPageViewModel

@{
    ViewData["Title"] = "Detalle de recomendación";
}

<section class="hero">
    <h1>Detalle de recomendación</h1>
    <p><a asp-action="Index">Volver a recomendaciones</a></p>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="status-ok">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="auth-error">@Model.ErrorMessage</div>
    }
</section>

<section class="hero dashboard-grid">
    <article>
        <h2>Resumen de la recomendación</h2>
        <p><strong>Estado:</strong> <span class="status-pill status-pill-@Model.Recommendation.Status.ToLowerInvariant()">@Model.Recommendation.Status</span></p>
        <p><strong>ID del producto:</strong> @Model.Recommendation.ProductId</p>
        <p><strong>Generado el:</strong> @Model.Recommendation.GeneratedAtUtc.ToString("u")</p>
        <p><strong>Unidades recomendadas:</strong> @Model.Recommendation.RecommendedUnits.ToString("N0")</p>
        <p><strong>Confianza:</strong> @Model.Recommendation.Confidence.ToString("P0")</p>
        <p><strong>Justificación:</strong> @Model.Recommendation.Rationale</p>
        <p><strong>Revisado por:</strong> @(Model.Recommendation.ReviewedBy ?? "Pendiente")</p>
        <p><strong>Revisado el:</strong> @(Model.Recommendation.ReviewedAtUtc?.ToString("u") ?? "Pendiente")</p>
        <p><strong>Notas de revisión:</strong> @(Model.Recommendation.ReviewNotes ?? "No hay notas registradas")</p>
    </article>

    <article>
        <h2>Acciones de revisión</h2>
        <form asp-action="Review" method="post" class="auth-form">
            @Html.AntiForgeryToken()
            <input asp-for="ReviewForm.RecommendationId" type="hidden" />

            <div class="form-group">
                <label asp-for="ReviewForm.Action">Acción</label>
                <select asp-for="ReviewForm.Action">
                    <option value="@RecommendationReviewActions.Approve">Aprobar</option>
                    <option value="@RecommendationReviewActions.Reject">Rechazar</option>
                    <option value="@RecommendationReviewActions.Analysis">Marcar para análisis</option>
                </select>
            </div>

            <div class="form-group">
                <label asp-for="ReviewForm.Notes">Notas</label>
                <input asp-for="ReviewForm.Notes" />
            </div>

            <button type="submit">Enviar revisión</button>
        </form>
    </article>
</section>
