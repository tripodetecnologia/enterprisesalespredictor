@model EnterpriseSalesPredictor.Web.ViewModels.Auth.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<section class="auth-container">
    <h1>Sign in</h1>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="auth-error">@Model.ErrorMessage</div>
    }

    <form asp-action="Login" asp-controller="Auth" method="post" class="auth-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />

        <div class="form-group">
            <label asp-for="Username"></label>
            <input asp-for="Username" autocomplete="username" />
            <span asp-validation-for="Username" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="current-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <button type="submit">Login</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
