@model EnterpriseSalesPredictor.Web.ViewModels.Forecasting.ForecastPageViewModel

@{
    ViewData["Title"] = "Proyecciones";
}

<section class="hero">
    <h1>Proyección de ventas</h1>
    <p>Selecciona un rango de fechas para proyectar ventas mensuales por cliente y por producto.</p>
    <br />
    <form id="forecast-form" class="audit-filters filter-panel">
        <div class="form-group">
            <label asp-for="Filters.FromDate">Desde</label>
            <input asp-for="Filters.FromDate" type="date" />
            <span asp-validation-for="Filters.FromDate" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Filters.ToDate">Hasta</label>
            <input asp-for="Filters.ToDate" type="date" />
            <span asp-validation-for="Filters.ToDate" class="field-error"></span>
        </div>

        <div class="form-group" style="margin-bottom:5px;">
            <label asp-for="Filters.CustomerId">Cliente</label>
            <select asp-for="Filters.CustomerId">
                <option value="">Todos los clientes</option>
                @foreach (var customer in Model.Customers)
                {
                    <option value="@customer.Id">@customer.Name</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label asp-for="Filters.ProductName">Producto</label>
            <select asp-for="Filters.ProductName">
                <option value="">Seleccione...</option>
                @foreach (var product in Model.Products)
                {
                    <option value="@product.Name">@product.Name</option>
                }
            </select>
            <span asp-validation-for="Filters.ProductName" class="field-error"></span>
        </div>

        <button type="submit">Generar proyección</button>
    </form>
</section>

<section class="hero" id="forecast-loading" hidden>
    <p>Generando proyección...</p>
</section>

<section class="hero auth-error" id="forecast-error" hidden></section>

<section class="hero" id="forecast-result" hidden>
    <h2>Resumen general</h2>

    <table class="data-table">
        <thead>
            <tr>
                <th>Ventas proyectadas totales</th>
                <th>Confianza promedio</th>
                <th>Generado el</th>
                <th>Generado por</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td id="forecast-projected-sales">0</td>
                <td id="forecast-confidence">0%</td>
                <td id="forecast-generated-at">-</td>
                <td id="forecast-generated-by">-</td>
            </tr>
        </tbody>
    </table>

    <h3>Resumen</h3>
    <p id="forecast-summary"></p>
</section>

<section class="hero table-card" id="forecast-customer-section" hidden>
    <h2>Proyección mensual por cliente</h2>
    <div class="page-actions sales-pagination-bar forecast-pagination-bar">
        <button type="button" id="forecast-customer-prev" class="button button-secondary" disabled>Anterior</button>
        <span id="forecast-customer-indicator">Página 1</span>
        <div id="forecast-customer-pages" class="sales-page-numbers"></div>
        <button type="button" id="forecast-customer-next" class="button button-secondary" disabled>Siguiente</button>
    </div>
    <p id="forecast-customer-summary">Mostrando 0 registros.</p>
    <table class="data-table">
        <thead>
            <tr>
                <th>Mes</th>
                <th>Cliente</th>
                <th>Ventas proyectadas</th>
                <th>Confianza</th>
            </tr>
        </thead>
        <tbody id="forecast-customer-body">
            <tr>
                <td colspan="4">Generá una proyección para ver resultados.</td>
            </tr>
        </tbody>
    </table>
</section>

<section class="hero table-card" id="forecast-product-section" hidden>
    <h2>Proyección mensual por producto</h2>
    <div class="page-actions sales-pagination-bar forecast-pagination-bar">
        <button type="button" id="forecast-product-prev" class="button button-secondary" disabled>Anterior</button>
        <span id="forecast-product-indicator">Página 1</span>
        <div id="forecast-product-pages" class="sales-page-numbers"></div>
        <button type="button" id="forecast-product-next" class="button button-secondary" disabled>Siguiente</button>
    </div>
    <p id="forecast-product-summary">Mostrando 0 registros.</p>
    <table class="data-table">
        <thead>
            <tr>
                <th>Mes</th>
                <th>Producto</th>
                <th>Unidades proyectadas</th>
                <th>Ventas proyectadas</th>
                <th>Confianza</th>
            </tr>
        </thead>
        <tbody id="forecast-product-body">
            <tr>
                <td colspan="5">Generá una proyección para ver resultados.</td>
            </tr>
        </tbody>
    </table>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/pages/forecasts-index.js" asp-append-version="true"></script>
}
