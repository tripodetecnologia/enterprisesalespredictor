@model EnterpriseSalesPredictor.Web.ViewModels.Forecasting.ForecastPageViewModel

@{
    ViewData["Title"] = "Forecasting";
}

<section class="hero">
    <h1>Sales Forecasting</h1>
    <p>Generate short and mid-term projections using the current forecasting baseline.</p>

    <form id="forecast-form" class="audit-filters">
        <div class="form-group">
            <label asp-for="Filters.FromDate">From</label>
            <input asp-for="Filters.FromDate" type="date" />
        </div>

        <div class="form-group">
            <label asp-for="Filters.ToDate">To</label>
            <input asp-for="Filters.ToDate" type="date" />
        </div>

        <div class="form-group">
            <label asp-for="Filters.ProductId">Product Id</label>
            <input asp-for="Filters.ProductId" />
        </div>

        <div class="form-group">
            <label asp-for="Filters.CustomerId">Customer Id</label>
            <input asp-for="Filters.CustomerId" />
        </div>

        <button type="submit">Generate forecast</button>
    </form>
</section>

<section class="hero" id="forecast-loading" hidden>
    <p>Generating forecast...</p>
</section>

<section class="hero auth-error" id="forecast-error" hidden></section>

<section class="hero" id="forecast-result" hidden>
    <h2>Forecast Result</h2>

    <div class="dashboard-kpi-grid forecast-kpi-grid">
        <article class="dashboard-kpi-card">
            <span class="dashboard-kpi-label">Projected Sales</span>
            <strong class="dashboard-kpi-value" id="forecast-projected-sales">0.00</strong>
        </article>
        <article class="dashboard-kpi-card">
            <span class="dashboard-kpi-label">Confidence</span>
            <strong class="dashboard-kpi-value" id="forecast-confidence">0%</strong>
        </article>
        <article class="dashboard-kpi-card">
            <span class="dashboard-kpi-label">Generated At</span>
            <strong class="dashboard-kpi-value forecast-small" id="forecast-generated-at">-</strong>
        </article>
        <article class="dashboard-kpi-card">
            <span class="dashboard-kpi-label">Generated By</span>
            <strong class="dashboard-kpi-value forecast-small" id="forecast-generated-by">-</strong>
        </article>
    </div>

    <div class="forecast-chart">
        <div class="forecast-chart-labels">
            <span>Forecast strength</span>
            <strong id="forecast-chart-value">0.00</strong>
        </div>
        <div class="dashboard-breakdown-bar-track forecast-chart-track">
            <div class="forecast-chart-fill" id="forecast-chart-fill"></div>
        </div>
    </div>

    <div class="hero">
        <h3>Summary</h3>
        <p id="forecast-summary"></p>
    </div>
</section>

@section Scripts {
    <script src="~/js/pages/forecasts-index.js" asp-append-version="true"></script>
}
