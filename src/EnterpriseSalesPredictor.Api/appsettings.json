{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=enterprise_sales_predictor;User Id=app_user;Password=app_password;"
  },
  "Database": {
    "Provider": "MySql",
    "CommandTimeoutSeconds": 30
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "EnterpriseSalesPredictor",
      "Audience": "EnterpriseSalesPredictor.Clients",
      "SigningKey": "replace-with-strong-key-at-least-32-characters",
      "ExpirationMinutes": 60
    },
    "Users": {
      "Users": [
        {
          "UserId": "11111111111111111111111111111111",
          "Username": "admin",
          "Password": "Admin@123",
          "Role": "Administrator",
          "Permissions": [
            "*"
          ]
        }
      ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
